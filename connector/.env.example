# ============================================================
# Supabase (Project Settings → API)
# Use a chave service_role APENAS aqui, no conector.
# NUNCA coloque esta chave no frontend.
# ============================================================
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# WhatsApp
# ============================================================
# IDs dos grupos monitorados (separados por vírgula).
# Rode `npm run groups` para descobrir os IDs.
# Deixe vazio e use MONITOR_ALL_GROUPS=true para todos.
WHATSAPP_GROUP_IDS=

# Alternativa: parte do nome do grupo (case-insensitive), separado por vírgula.
WHATSAPP_GROUP_MATCH=

# Monitorar todos os grupos (true/false).
MONITOR_ALL_GROUPS=false

# Pasta onde a sessão do WhatsApp é salva (não versionar).
WHATSAPP_SESSION_DIR=./data/auth

# ============================================================
# Regras de negócio
# ============================================================
# Mensagens do mesmo solicitante dentro desta janela entram no mesmo chamado.
MERGE_WINDOW_MINUTES=15
# Prazo de SLA em horas.
SLA_HOURS=24
# Mensagens menores que isso são ignoradas (saudações etc.).
MIN_MESSAGE_LENGTH=6

# ============================================================
# IA opcional (OpenAI-compatible: Groq, Gemini, OpenRouter, etc.)
# Deixe AI_ENABLED=false para usar somente regras.
# ============================================================
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# info | debug
LOG_LEVEL=info
